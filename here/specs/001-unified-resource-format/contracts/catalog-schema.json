{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://textmuy.local/contracts/catalog-schema.json",
  "title": "ResourceCatalog — catalogo unico por ambito (uploads/tm)",
  "description": "Un JSON por ambito bajo wp-content/uploads/tm/ (= espejo ../uploads/tm/): fonts/fonts.json, img/img.json, presets/presets.json. Items = tuplas [id,title,cats,file]; libre = tombstone [id,'','',''].",
  "type": "object",
  "required": ["thumbs", "items"],
  "additionalProperties": false,
  "properties": {
    "thumbs": {
      "type": "object",
      "required": ["w", "h", "c"],
      "additionalProperties": false,
      "properties": {
        "w": { "type": "integer", "minimum": 1 },
        "h": { "type": "integer", "minimum": 1 },
        "c": { "type": "integer", "minimum": 1 }
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "array",
        "minItems": 4,
        "maxItems": 4,
        "items": [
          { "type": "integer", "minimum": 1 },
          { "type": "string" },
          { "type": "string" },
          { "type": "string" }
        ]
      }
    }
  }
}
